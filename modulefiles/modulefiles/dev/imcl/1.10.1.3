#%Module1.0#####################################################################
##
## imcl modulefile
##
proc ModulesHelp { } {
        global version prefix

        puts stderr "\timcl - loads the IBM Installation Manager command line (imcl)"
        puts stderr "\n\tThis adds $prefix/* to several of the"
        puts stderr "\tenvironment variables."
        puts stderr "\n\tUse 'imcl' for command-line installs (e.g. WebSphere)."
        puts stderr "\n\tVersion $version\n"
}

module-whatis	"loads the IBM Installation Manager 1.10.1.3 (imcl) environment"

# for Tcl script use only
set	version		1.10.1.3
set	prefix		/opt/imcl/$version

# Installation Manager bundles its own Java 11, so no java module is loaded

setenv        IM_HOME      $prefix/eclipse
setenv        IM_DATA      /opt/imcl/data/$version
prepend-path  PATH         $prefix/eclipse/tools

# Optional GUI launcher
set-alias     IBMIM        "$prefix/eclipse/IBMIM"

conflict dev/imcl
