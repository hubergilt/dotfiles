#%Module1.0
proc ModulesHelp { } {
    puts stderr "PostgreSQL 14.23"
}

module-whatis "PostgreSQL 14.23 database"

conflict db/postgresql

set pgversion 14
set basedir /usr/lib/postgresql/$pgversion

prepend-path PATH            $basedir/bin
prepend-path LD_LIBRARY_PATH $basedir/lib
prepend-path MANPATH         /usr/share/postgresql/$pgversion/man

setenv PGDATA /var/lib/postgresql/$pgversion/main
setenv PGHOME $basedir
setenv PGCONFDIR /etc/postgresql/$pgversion/main

# PostgreSQL convenience functions (moved from ~/.bash_aliases)
set-function pgstart {
    local PGUSER="${1:-postgres}"
    local _pwd; _pwd="$(pwd)"
    cd /tmp || return 1
    sudo -u "$PGUSER" $PGHOME/bin/pg_ctl -D $PGDATA -o "-c config_file=$PGCONFDIR/postgresql.conf" -l $PGDATA/logfile start
    cd "$_pwd" || return 1
}

set-function pgstop {
    local PGUSER="${1:-postgres}"
    local _pwd; _pwd="$(pwd)"
    cd /tmp || return 1
    sudo -u "$PGUSER" $PGHOME/bin/pg_ctl -D $PGDATA stop
    cd "$_pwd" || return 1
}

set-function pgstatus {
    local PGUSER="${1:-postgres}"
    local _pwd; _pwd="$(pwd)"
    cd /tmp || return 1
    sudo -u "$PGUSER" $PGHOME/bin/pg_ctl -D $PGDATA status
    cd "$_pwd" || return 1
}

set-function pgrestart {
    local PGUSER="${1:-postgres}"
    local _pwd; _pwd="$(pwd)"
    cd /tmp || return 1
    sudo -u "$PGUSER" $PGHOME/bin/pg_ctl -D $PGDATA -o "-c config_file=$PGCONFDIR/postgresql.conf" -l $PGDATA/logfile restart
    cd "$_pwd" || return 1
}

set-function pgsql {
    local PGUSER="${1:-postgres}"
    local _pwd; _pwd="$(pwd)"
    cd /tmp || return 1
    sudo -u "$PGUSER" $PGHOME/bin/psql
    cd "$_pwd" || return 1
}
