#%Module1.0#####################################################################
##
## Java 21.0.12 Oracle Modulefile
##
proc ModulesHelp { } {
        global version prefix

        puts stderr "\tjava/21.0.12 - loads the Oracle 21.0.12 environment"
        puts stderr "\n\tThis adds $prefix/bin to your PATH and sets JAVA_HOME."
        puts stderr "\n\tVersion $version\n"
}

module-whatis	"loads the Oracle JDK 21.0.12 environment"

# Specific version and path settings
set	version		21.0.12
# The Adoptium tarball typically extracts into a folder named '21.0.12'
set	prefix		/opt/java/oracle/jdk/$version

setenv        JAVA_HOME $prefix
prepend-path  PATH   	  $prefix/bin

# Handling conflicts
set conflicts "~/modulefiles/java/conflicts.tcl"
if { [file exists $conflicts] } {
    source $conflicts
    proc_conflicts
}
