#%Module1.0#####################################################################
##
## wildfly modulefile
##
proc ModulesHelp { } {
        global version prefix

        puts stderr "\twildfly - loads the WildFly application server environment"
        puts stderr "\n\tThis adds $prefix/* to several of the"
        puts stderr "\tenvironment variables."
        puts stderr "\n\tVersion $version\n"
}

module-whatis	"loads the WildFly 39.0.0.Final environment"

# for Tcl script use only
set	version		39.0.0
set	prefix		/opt/wildfly/$version

# WildFly requires Java
if { ![is-loaded java] } {
    module load java/25.0.1
}

setenv        JBOSS_HOME   $prefix
setenv        WILDFLY_HOME $prefix
prepend-path  PATH         $prefix/bin

# Create aliases for easy management
# Run as the dedicated `wildfly` service account, not whoever loaded this
# module — --preserve-env is required since sudo resets the environment by
# default, which would otherwise drop JAVA_HOME set by `module load java`.
set-alias     wildfly-start      "(cd $prefix && sudo --preserve-env=JAVA_HOME,JBOSS_HOME,WILDFLY_HOME,PATH -u wildfly $prefix/bin/standalone.sh)"
set-alias     wildfly-start-bg   "(cd $prefix && sudo --preserve-env=JAVA_HOME,JBOSS_HOME,WILDFLY_HOME,PATH -u wildfly $prefix/bin/standalone.sh > /dev/null 2>&1 &)"
set-alias     wildfly-stop       "sudo --preserve-env=JAVA_HOME,JBOSS_HOME,WILDFLY_HOME,PATH -u wildfly $prefix/bin/jboss-cli.sh --connect command=:shutdown"
set-alias     wildfly-domain     "(cd $prefix && sudo --preserve-env=JAVA_HOME,JBOSS_HOME,WILDFLY_HOME,PATH -u wildfly $prefix/bin/domain.sh)"
set-alias     wildfly-cli        "sudo --preserve-env=JAVA_HOME,JBOSS_HOME,WILDFLY_HOME,PATH -u wildfly $prefix/bin/jboss-cli.sh"
set-alias     wildfly-logs       "tail -f $prefix/standalone/log/server.log"

# enable module versioning modulepath
#module use {~/modulefiles/wildfly/$version}
